{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/HANDOFF.md\" 2>/dev/null || echo 'HANDOFF.md なし'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__Google_Drive",
      "mcp__Gmail",
      "mcp__Notion",
      "mcp__github",
      "mcp__claude-code-remote",
      "Artifact",
      "ArtifactData",
      "ArtifactComments",
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Skill",
      "Agent"
    ]
  }
}