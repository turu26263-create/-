{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/HANDOFF.md\" 2>/dev/null || echo 'HANDOFF.md なし'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Artifact",
      "ArtifactData",
      "ArtifactComments",
      "mcp__Google_Drive__update_file",
      "mcp__Google_Drive__create_file"
    ]
  }
}
